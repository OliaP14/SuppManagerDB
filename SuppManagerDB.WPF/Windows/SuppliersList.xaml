<Window x:Class="SuppManagerDB.WPF.Windows.SuppliersList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Постачальники" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#e6ffff">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ПОШУК -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 10">
            <TextBox x:Name="txtSearch"
                     Width="250" Height="28" Margin="0 0 10 0" FontSize="14"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <Button x:Name="btnSearch" Content="Пошук"
                    Width="50" Height="28"
                    Background="#003366" Foreground="White"
                    Command="{Binding SearchSupplierCommand}"/>

            <!-- Кнопка -->
            <Button
            Content="Вийти"
            Width="101" Height="38"
            Background="#00b3b3"
            Foreground="Black"
            FontWeight="Bold"
            Margin="200,0,0,0"
            Click="Logout_Click"/>
            

            
        </StackPanel>

        <!-- ТАБЛИЦЯ -->
        <DataGrid x:Name="dgSuppliers" Grid.Row="1"
                  AutoGenerateColumns="False"
                  FontSize="14"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  RowHeaderWidth="0"
                  Margin="0 0 0 10"
                  ItemsSource="{Binding Suppliers}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Інформація" Binding="{Binding Info}" Width="200"/>
                <DataGridTextColumn Header="Локація" Binding="{Binding Location}" Width="150"/>
                <DataGridCheckBoxColumn Header="Активний" Binding="{Binding Status}" Width="100"/>

                <!--  КНОПКИ ДІЙ -->
                <DataGridTemplateColumn Header="Дії" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <Button Content="Переглянути" Width="80" Margin="3"
                                        Command="{Binding DataContext.OpenDetailsCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding SupplierID}"/>

                                <Button Content="Блок" Width="45" Margin="3" Background="#990000" Foreground="White"
                                        Command="{Binding DataContext.BlockSupplierCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding SupplierID}"/>

                                <Button Content="ОК" Width="30" Margin="3" Background="#006600" Foreground="White"
                                        Command="{Binding DataContext.UnblockSupplierCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding SupplierID}"/>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ДОДАВАННЯ НОВОГО -->
        <Button x:Name="btnAdd" Grid.Row="2" Content="Додати"
        Width="120" Height="35"
        HorizontalAlignment="Right"
        Background="#003366" Foreground="White"
        Command="{Binding AddSupplierCommand}"/>

    </Grid>
</Window>
