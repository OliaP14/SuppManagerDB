<Window x:Class="SuppManagerDB.WPF.Windows.SupplierProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товари постачальника" Width="800" Height="450"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Таблиця товарів -->
        <DataGrid x:Name="ProductsGrid"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,10"/>

        <!--  Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Додати товар" Width="140" Height="35"
                    Background="#006600" Foreground="White"
                    Click="AddProduct_Click"/>
            
            <!--Додала редагування-->

            <Button Content="Редагувати товар" Width="120" Background="#004DA1" Foreground="White"
            Margin="10,0,0,0"
            Click="EditProduct_Click"/>

            <Button Content="Видалити товар" Width="140" Height="35" Margin="10,0,0,0"
                    Background="#CC0000" Foreground="White"
                    Click="DeleteProduct_Click"/>

            <Button Content="Закрити" Width="120" Height="35" Margin="10,0,0,0"
                    Background="#777" Foreground="White"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
