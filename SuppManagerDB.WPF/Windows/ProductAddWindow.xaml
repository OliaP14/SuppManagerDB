<Window x:Class="SuppManagerDB.WPF.Windows.ProductAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Додати товар" Height="502" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#e6ffff">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поля вводу -->
        <StackPanel>

            <TextBlock Text="Назва товару" Margin="0,0,0,3" FontSize="14"/>
            <TextBox x:Name="txtName" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Модель" Margin="0,0,0,3" FontSize="14"/>
            <TextBox x:Name="txtModel" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Кількість штук" Margin="0,0,0,3" FontSize="14"/>
            <TextBox x:Name="txtNumber" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Ціна" Margin="0,0,0,3" FontSize="14"/>
            <TextBox x:Name="txtPrice" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Категорія" Margin="0,0,0,3" FontSize="14"/>
            <ComboBox x:Name="cmbCategory" Height="28"
                      DisplayMemberPath="CategoryName"
                      SelectedValuePath="CategoryID"
                      Margin="0,0,0,10"/>

            <TextBlock Text="Виробник" Margin="0,0,0,3" FontSize="14" Height="24"/>
            <ComboBox x:Name="cmbManufacturer" Height="33"
                      DisplayMemberPath="Name"
                      SelectedValuePath="ManufacturerID"
                      Margin="0,0,0,10" RenderTransformOrigin="0.503,-0.562" SelectionChanged="cmbManufacturer_SelectionChanged"/>
        </StackPanel>

        <!--  Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Створити" Width="120" Height="35"
                    Background="#003366" Foreground="White"
                    Click="Create_Click"/>
            <Button Content="Закрити" Width="120" Height="35" Margin="10,0,0,0"
                    Background="#777" Foreground="White"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
