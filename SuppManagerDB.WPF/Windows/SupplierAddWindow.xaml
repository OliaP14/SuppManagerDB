<Window x:Class="SuppManagerDB.WPF.Windows.SupplierAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новий постачальник" Height="350" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#f0f2f5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBlock Text="Назва компанії" Margin="0,0,0,3" FontSize="14"/>
            <TextBox x:Name="txtName" Height="28" FontSize="14"/>

            <TextBlock Text="Контакти (телефон/e-mail)" Margin="10,10,0,3" FontSize="14"/>
            <TextBox x:Name="txtInfo" Height="28" FontSize="14"/>

            <TextBlock Text="Локація" Margin="10,10,0,3" FontSize="14"/>
            <TextBox x:Name="txtLocation" Height="28" FontSize="14"/>

        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Створити" Width="120" Height="35"
                    Background="#003366" Foreground="White"
                    Click="Create_Click"/>

            <Button Content="Закрити" Width="120" Height="35" Margin="10,0,0,0"
                    Background="#777" Foreground="White"
                    Click="Close_Click"/>
        </StackPanel>

    </Grid>
</Window>
